# Copy this file to ".env" and change what you need. The .env file is never uploaded to git.
# Every line is optional: without a .env file the app runs with safe defaults.

# --- Server ---
# HOST=0.0.0.0              # allow other computers on the network (default: only this computer)
# PORT=5000
# BEHIND_PROXY=1            # set when an HTTPS reverse proxy (Caddy, nginx) sits in front
# SESSION_COOKIE_SECURE=1   # set when the site is opened over https://

# --- First admin (otherwise the browser asks on first start) ---
# ADMIN_ID=admin
# ADMIN_PASSWORD=choose-a-long-password
# ALLOW_REMOTE_SETUP=1      # allow the set-up page from another computer

# --- Secrets (generated automatically when left empty) ---
# SECRET_KEY=
# KIOSK_KEY=

# --- Storage ---
# DATABASE_URL=sqlite:///C:/attendance-data/attendance.db
# SNAPSHOT_DIR=C:/attendance-data/snapshots
# PROFILE_DIR=C:/attendance-data/profile_photos

# --- Email notifications ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=hr@yourcompany.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=hr@yourcompany.com
# SMTP_USE_SSL=1            # only for port 465
